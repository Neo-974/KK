# Copier ce fichier vers .env et adapter les valeurs
DATABASE_URL=postgresql://kk:kk_dev_password@localhost:5432/kk
JWT_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
# Clé API Anthropic (platform.claude.com → Clés API) pour la génération de posts par IA
ANTHROPIC_API_KEY=sk-ant-...
# Réglages IA optionnels (valeurs par défaut ci-dessous)
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT=30
# ANTHROPIC_MAX_RETRIES=3
